        "# ============================================================\n",
        "# CELL 10 — OPTIONAL COLAB MULTI-VIEW TEST\n",
        "# ============================================================\n",
        "\n",
        "from google.colab import files\n",
        "from pathlib import Path\n",
        "import requests\n\nprint(\"=\" * 70)\nprint(\"UPLOAD MULTI-VIEW IMAGES\")\nprint(\"=\" * 70)\nprint(\n    \"ตั้งชื่อไฟล์ให้มี front / left / back / right\"\n)\n\nuploaded = files.upload()\n\nviews = {}\n\nfor filename in uploaded.keys():\n\n    lower = filename.lower()\n    path = Path(\"/content\") / filename\n\n    if \"front\" in lower:\n        views[\"front\"] = path\n    elif \"left\" in lower:\n        views[\"left\"] = path\n    elif \"back\" in lower:\n        views[\"back\"] = path\n    elif \"right\" in lower:\n        views[\"right\"] = path\n\nif len(views) < 2:\n    raise RuntimeError(\n        \"เลือกอย่างน้อย 2 รูป และตั้งชื่อ front/left/back/right\"\n    )\n\nprint(\n    \"Views:\",\n    list(views.keys())\n)\n\nhandles = []\nfiles_payload = []\n\ntry:\n\n    for role, path in views.items():\n\n        handle = open(\n            path,\n            \"rb\"\n        )\n\n        handles.append(handle)\n\n        files_payload.append(\n            (\n                role,\n                (\n                    path.name,\n                    handle,\n                    \"application/octet-stream\",\n                )\n            )\n        )\n\n    response = requests.post(\n        PUBLIC_URL + \"/generate_multi\",\n        files=files_payload,\n        timeout=3600,\n    )\n\nfinally:\n\n    for handle in handles:\n        try:\n            handle.close()\n        except Exception:\n            pass\n\nresponse.raise_for_status()\n\nresult = response.json()\n\nprint()\nprint(\"SERVER RESPONSE:\")\nprint(result)\n\nresult_url = (\n    PUBLIC_URL\n    + result[\"result\"]\n)\n\noutput = (\n    Path(\"/content\")\n    / result[\"filename\"]\n)\n\nprint()\nprint(\"Downloading GLB...\")\n\nwith requests.get(\n    result_url,\n    stream=True,\n    timeout=600,\n) as response:\n\n    response.raise_for_status()\n\n    with open(\n        output,\n        \"wb\"\n    ) as f:\n\n        for chunk in response.iter_content(\n            chunk_size=1024 * 1024\n        ):\n\n            if chunk:\n                f.write(chunk)\n\nprint()\nprint(\"=\" * 70)\nprint(\"✅ MULTI-VIEW TEST COMPLETE\")\nprint(\"=\" * 70)\nprint(\n    \"Output:\",\n    output\n)\nprint(\n    \"Size:\",\n    round(\n        output.stat().st_size / 1024**2,\n        2\n    ),\n    \"MB\"\n)\n"
