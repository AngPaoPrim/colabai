        "# ============================================================\n",
        "# CELL 6 — TEST HUNYUAN3D-2MV LOAD ONLY\n",
        "# ============================================================\n",
        "\n",
        "import subprocess\n\nPYTHON = \"/content/hunyuan_mv_env/bin/python\"\nREPO = \"/content/Hunyuan3D-2\"\n\nTEST = r'''\\\nimport torch\n\nfrom hy3dgen.shapegen import (\n    Hunyuan3DDiTFlowMatchingPipeline\n)\n\nprint(\"Loading Hunyuan3D-2mv Turbo...\")\n\npipeline = (\n    Hunyuan3DDiTFlowMatchingPipeline\n    .from_pretrained(\n        \"tencent/Hunyuan3D-2mv\",\n        subfolder=\"hunyuan3d-dit-v2-mv-turbo\",\n        variant=\"fp16\",\n        use_safetensors=True,\n        device=\"cuda\",\n    )\n)\n\nprint(\"MODEL LOAD OK\")\n\nprint(\n    \"VRAM:\",\n    round(\n        torch.cuda.memory_allocated() / 1024**3,\n        2\n    ),\n    \"GB\"\n)\n'''\n\nresult = subprocess.run(\n    [\n        PYTHON,\n        \"-c\",\n        TEST\n    ],\n    cwd=REPO,\n    capture_output=True,\n    text=True\n)\n\nprint(result.stdout)\n\nif result.returncode != 0:\n    print(result.stderr)\n    raise RuntimeError(\n        \"2MV model load test failed.\"\n    )\n\nprint(\"2MV LOAD TEST PASSED\")\n"
