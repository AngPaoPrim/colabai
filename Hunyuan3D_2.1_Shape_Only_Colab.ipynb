        "# ============================================================\n",
        "# CELL 5 — VERIFY EVERYTHING\n",
        "# ============================================================\n",
        "\n",
        "import subprocess\n",
        "\n",
        "PYTHON = \"/content/hunyuan_mv_env/bin/python\"\n",
