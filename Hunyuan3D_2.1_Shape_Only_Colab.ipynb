        "    shutil.rmtree(ENV, ignore_errors=True)\n",
        "\n",
        "print(\"Creating Python 3.10 environment...\")\n",
        "\n",
        "subprocess.run(\n",
        "    [\"python3.10\", \"-m\", \"venv\", str(ENV)],\n",
        "    check=True\n",
        ")\n",
        "\n",
        "subprocess.run(\n",
        "    [\n",
        "        str(PYTHON),\n",
        "        \"-m\", \"pip\", \"install\", \"-U\",\n",
        "        \"pip\", \"setuptools\", \"wheel\"\n",
        "    ],\n",
        "    check=True\n",
        ")\n",
        "\n",
        "print(\n",
        "    subprocess.check_output(\n",
        "        [str(PYTHON), \"--version\"],\n",
        "        text=True\n",
