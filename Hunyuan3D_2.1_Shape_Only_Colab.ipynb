      "source": [
        "# ============================================================\n",
        "# CELL 5 — CREATE MULTI-VIEW SERVER\n",
        "# ============================================================\n",
        "\n",
        "from pathlib import Path\n",
        "import subprocess\n",
        "import time\n\n",
        "PYTHON = \"/content/hunyuan_mv_env/bin/python\"\n",
        "REPO = \"/content/Hunyuan3D-2\"\n",
        "BASE = Path(\"/content/hunyuan3d_mv_server\")\n",
        "\n",
        "BASE.mkdir(parents=True, exist_ok=True)\n\n",
        "SCRIPT = BASE / \"server.py\"\n",
        "LOG = BASE / \"server.log\"\n\n",
        "subprocess.run(\n",
        "    [\"pkill\", \"-f\", str(SCRIPT)],\n",
        "    stdout=subprocess.DEVNULL,\n",
        "    stderr=subprocess.DEVNULL,\n",
        "    check=False\n",
        ")\n\n",
        "time.sleep(2)\n\n",
        "SERVER = r'''\\\n",
        "import os\n",
        "import sys\n",
        "import gc\n",
        "import uuid\n",
        "import traceback\n",
        "from pathlib import Path\n",
        "from typing import Optional\n",
        "\n",
        "import torch\n",
        "from PIL import Image\n",
        "\n",
        "from fastapi import FastAPI, UploadFile, File, HTTPException\n",
        "from fastapi.responses import FileResponse\n",
        "import uvicorn\n",
        "\n",
        "os.environ[\"PYTORCH_CUDA_ALLOC_CONF\"] = \"expandable_segments:True\"\n",
        "os.environ[\"CUDA_MODULE_LOADING\"] = \"LAZY\"\n",
        "\n",
        "from hy3dgen.shapegen import Hunyuan3DDiTFlowMatchingPipeline\n",
        "\n",
        "BASE = Path(\"/content/hunyuan3d_mv_server\")\n",
        "UPLOADS = BASE / \"uploads\"\n",
        "OUTPUTS = BASE / \"outputs\"\n        "\n",
        "UPLOADS.mkdir(parents=True, exist_ok=True)\n",
        "OUTPUTS.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "print(\"=\" * 70, flush=True)\n",
        "print(\"HUNYUAN3D-2MV TURBO\", flush=True)\n",
        "print(\"=\" * 70, flush=True)\n",
        "\n",
        "print(\"Python:\", sys.version, flush=True)\n",
        "print(\"Torch:\", torch.__version__, flush=True)\n",
        "print(\"GPU:\", torch.cuda.get_device_name(0), flush=True)\n",
        "print(\n",
        "    \"VRAM:\",\n",
        "    round(\n",
        "        torch.cuda.get_device_properties(0).total_memory / 1024**3,\n",
        "        2\n",
        "    ),\n",
        "    \"GB\",\n",
        "    flush=True\n",
        ")\n",
        "\n",
        "print(\"Loading model...\", flush=True)\n",
        "\n",
        "pipeline = Hunyuan3DDiTFlowMatchingPipeline.from_pretrained(\n",
        "    \"tencent/Hunyuan3D-2mv\",\n",
        "    subfolder=\"hunyuan3d-dit-v2-mv-turbo\",\n",
        "    variant=\"fp16\",\n",
        "    use_safetensors=True,\n",
        "    device=\"cuda\",\n",
        ")\n",
        "\n",
        "print(\"MODEL LOAD OK\", flush=True)\n",
        "print(\n",
        "    \"VRAM allocated:\",\n",
        "    round(torch.cuda.memory_allocated() / 1024**3, 2),\n",
        "    \"GB\",\n",
        "    flush=True\n",
        ")\n",
        "\n",
        "try:\n",
        "    pipeline.enable_flashvdm()\n",
        "    print(\"FlashVDM: ENABLED\", flush=True)\n",
        "except Exception as e:\n",
        "    print(\"FlashVDM: NOT ENABLED:\", repr(e), flush=True)\n",
        "\n",
        "app = FastAPI(\n",
        "    title=\"Hunyuan3D-2mv Multi-View API\"\n",
        ")\n",
        "\n",
        "@app.get(\"/health\")\n",
        "def health():\n",
        "    return {\n",
        "        \"status\": \"ok\",\n",
        "        \"model\": \"tencent/Hunyuan3D-2mv\",\n",
        "        \"mode\": \"multi-view\",\n",
        "        \"gpu\": torch.cuda.get_device_name(0),\n        "        \"vram_allocated_gb\": round(\n",
        "            torch.cuda.memory_allocated() / 1024**3,\n",
        "            2\n",
        "        ),\n",
        "    }\n",
        "\n",
        "@app.post(\"/generate_multi\")\n",
        "async def generate_multi(\n",
        "    front: Optional[UploadFile] = File(None),\n",
        "    left: Optional[UploadFile] = File(None),\n",
        "    back: Optional[UploadFile] = File(None),\n",
        "    right: Optional[UploadFile] = File(None),\n",
        "):\n",
        "\n",
        "    incoming = {\n",
        "        \"front\": front,\n",
        "        \"left\": left,\n",
        "        \"back\": back,\n",
        "        \"right\": right,\n",
        "    }\n",
        "\n",
        "    views = {}\n",
        "    temp_files = []\n",
        "\n",
        "    try:\n",
        "\n",
        "        for role, upload in incoming.items():\n",
        "\n",
        "            if upload is None:\n",
        "                continue\n",
        "\n",
        "            filename = Path(\n",
        "                upload.filename or f\"{role}.png\"\n",
        "            ).name\n",
        "\n",
        "            path = (\n",
        "                UPLOADS\n",
        "                / f\"{uuid.uuid4().hex[:8]}_{filename}\"\n",
        "            )\n",
        "\n",
        "            path.write_bytes(\n",
        "                await upload.read()\n",
        "            )\n",
        "\n",
        "            temp_files.append(path)\n",
        "\n",
        "            views[role] = (\n",
        "                Image.open(path).convert(\"RGBA\")\n",
        "            )\n",
        "\n",
        "        if len(views) < 2:\n",
        "            raise HTTPException(\n",
        "                status_code=400,\n",
        "                detail=(\n",
        "                    \"Need at least 2 views. \"\n",
        "                    \"Use front/left/back/right.\"\n",
        "                )\n",
        "            )\n",
        "\n",
        "        print(\"=\" * 70, flush=True)\n",
        "        print(\n",
        "            \"MULTI-VIEW GENERATION:\",\n",
        "            list(views.keys()),\n",
        "            flush=True\n",
        "        )\n",
        "        print(\"=\" * 70, flush=True)\n",
        "\n",
        "        with torch.inference_mode():\n",
        "\n",
        "            mesh = pipeline(\n",
        "                image=views,\n",
        "                num_inference_steps=5,\n",
        "                octree_resolution=380,\n",
        "                num_chunks=20000,\n",
        "                generator=torch.manual_seed(12345),\n",
        "                output_type=\"trimesh\",\n",
        "            )[0]\n",
        "\n",
        "        print(\"MESH GENERATED\", flush=True)\n",
        "\n",
        "        filename = (\n",
        "            \"multiview_\"\n",
        "            + uuid.uuid4().hex[:10]\n",
        "            + \".glb\"\n",
        "        )\n",
        "\n",
        "        output = OUTPUTS / filename\n\n",
        "        mesh.export(str(output))\n",
        "\n",
        "        print(\n",
        "            \"GLB CREATED:\",\n",
        "            output,\n",
        "            flush=True\n",
        "        )\n",
        "\n",
        "        del mesh\n",
        "        del views\n",
        "\n",
        "        gc.collect()\n",
        "        torch.cuda.empty_cache()\n",
        "\n",
        "        return {\n",
        "            \"status\": \"completed\",\n",
        "            \"filename\": filename,\n",
        "            \"result\": \"/result/\" + filename,\n",
        "        }\n",
        "\n",
        "    except HTTPException:\n",
        "        raise\n",
        "\n",
        "    except Exception as e:\n",
        "\n",
        "        traceback.print_exc()\n",
        "\n",
        "        raise HTTPException(\n",
        "            status_code=500,\n",
        "            detail=str(e)\n",
        "        )\n",
        "\n",
        "    finally:\n",
        "\n",
        "        for path in temp_files:\n",
        "            try:\n",
        "                path.unlink()\n",
        "            except Exception:\n",
        "                pass\n",
        "\n",
        "@app.get(\"/result/{filename}\")\n",
        "def result(filename: str):\n",
        "\n",
        "    safe = Path(filename).name\n",
        "    path = OUTPUTS / safe\n",
        "\n",
        "    if not path.exists():\n",
        "        raise HTTPException(\n",
        "            status_code=404,\n",
        "            detail=\"Result not found\"\n",
        "        )\n",
        "\n",
        "    return FileResponse(\n",
        "        str(path),\n",
        "        media_type=\"model/gltf-binary\",\n",
        "        filename=safe,\n",
        "    )\n",
        "\n",
        "print(\"Starting FastAPI on port 8001...\", flush=True)\n",
        "\n",
        "uvicorn.run(\n",
        "    app,\n",
        "    host=\"127.0.0.1\",\n",
        "    port=8001,\n",
        "    log_level=\"info\"\n",
        ")\n",
        "'''\n\n",
        "SCRIPT.write_text(SERVER)\n\n",
        "subprocess.run(\n        "[PYTHON, \"-m\", \"py_compile\", str(SCRIPT)],\n        "check=True\n",
        ")\n\n",
        "print(\"SYNTAX: OK\")\n\n",
        "log_handle = open(LOG, \"w\", buffering=1)\n\n",
        "process = subprocess.Popen(\n",
        "    [PYTHON, \"-u\", str(SCRIPT)],\n",
        "    cwd=REPO,\n",
        "    stdout=log_handle,\n",
        "    stderr=subprocess.STDOUT,\n",
        "    start_new_session=True,\n",
        ")\n\n",
        "print(\"PID:\", process.pid)\n",
        "print(\"LOG:\", LOG)\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "cell7"
      },
      "execution_count": null,
      "outputs": [],
      "source": [
        "# ============================================================\n",
        "# CELL 7 — WAIT FOR MULTI-VIEW API\n",
        "# ============================================================\n",
        "\n",
        "import time\n",
        "import requests\n",
        "from pathlib import Path\n\n",
        "LOG = Path(\n",
        "    \"/content/hunyuan3d_mv_server/server.log\"\n",
        ")\n\n",
        "START = time.time()\n",
        "TIMEOUT = 1200\n\n",
        "print(\"=\" * 70)\n",
        "print(\"WAITING FOR MULTI-VIEW API\")\n",
        "print(\"=\" * 70)\n\n",
        "while True:\n\n",
        "    try:\n",
        "        r = requests.get(\n",
        "            \"http://127.0.0.1:8001/health\",\n",
        "            timeout=5\n",
        "        )\n\n",
        "        if r.status_code == 200:\n\n",
        "            print()\n",
        "            print(\"=\" * 70)\n",
        "            print(\"✅ MULTI-VIEW API READY\")\n",
        "            print(\"=\" * 70)\n",
        "            print(r.json())\n",
        "            break\n\n",
        "    except Exception:\n",
        "        pass\n\n",
        "    if time.time() - START > TIMEOUT:\n\n",
        "        print()\n",
        "        print(\"=\" * 70)\n",
        "        print(\"❌ STARTUP TIMEOUT\")\n",
        "        print(\"=\" * 70)\n\n",
        "        if LOG.exists():\n",
        "            print(\n",
        "                LOG.read_text(\n",
        "                    errors=\"replace\"\n",
        "                )[-30000:]\n",
        "            )\n\n",
        "        raise TimeoutError(\n",
        "            \"Multi-view API did not start.\"\n",
        "        )\n\n",
        "    time.sleep(5)\n"
      ]
    },
    {
      "cell_type": "code",
