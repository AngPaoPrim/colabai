        "# ============================================================\n",
        "# CELL 3 — CLONE + INSTALL OFFICIAL HUNYUAN3D-2\n",
        "# ============================================================\n",
        "\n",
        "from pathlib import Path\n",
        "import shutil\n",
        "import subprocess\n",
        "\n",
        "REPO = Path(\"/content/Hunyuan3D-2\")\n",
        "PYTHON = \"/content/hunyuan_mv_env/bin/python\"\n",
        "\n",
        "if REPO.exists():\n",
        "    print(\"Removing old repository...\")\n",
        "    shutil.rmtree(REPO, ignore_errors=True)\n",
        "\n",
        "print(\"Cloning official repository...\")\n",
        "\n",
        "subprocess.run(\n",
        "    [\n",
        "        \"git\", \"clone\",\n",
        "        \"--recurse-submodules\",\n",
        "        \"https://github.com/Tencent-Hunyuan/Hunyuan3D-2.git\",\n",
        "        str(REPO)\n",
        "    ],\n",
        "    check=True\n",
        ")\n",
        "\n",
        "subprocess.run(\n",
        "    [\n",
        "        \"git\", \"submodule\", \"update\",\n",
        "        \"--init\", \"--recursive\"\n",
        "    ],\n",
        "    cwd=str(REPO),\n",
        "    check=True\n",
        ")\n\n",
        "print(\"Installing PyTorch...\")\n\n",
        "subprocess.run(\n",
        "    [\n",
        "        PYTHON, \"-m\", \"pip\", \"install\",\n",
        "        \"torch==2.5.1\",\n",
        "        \"torchvision==0.20.1\",\n",
        "        \"torchaudio==2.5.1\",\n",
        "        \"--index-url\",\n",
        "        \"https://download.pytorch.org/whl/cu124\"\n",
        "    ],\n",
        "    check=True\n",
        ")\n\n",
        "print(\"Installing hy3dgen...\")\n\n",
        "subprocess.run(\n",
        "    [\n",
        "        PYTHON, \"-m\", \"pip\", \"install\",\n",
        "        \"-e\", str(REPO), \"--no-deps\"\n",
        "    ],\n",
        "    cwd=str(REPO),\n",
        "    check=True\n",
        ")\n\n",
        "PACKAGES = [\n",
        "    \"diffusers\",\n",
        "    \"transformers\",\n",
        "    \"accelerate\",\n",
        "    \"einops\",\n",
        "    \"omegaconf\",\n",
        "    \"opencv-python\",\n",
        "    \"numpy\",\n",
        "    \"pillow\",\n",
        "    \"trimesh\",\n",
        "    \"pymeshlab\",\n",
        "    \"pygltflib\",\n",
        "    \"xatlas\",\n",
        "    \"timm\",\n",
        "    \"pyyaml\",\n",
        "    \"ninja\",\n",
        "    \"pybind11\",\n",
        "    \"rembg\",\n",
        "    \"onnxruntime\",\n",
        "    \"fastapi\",\n",
        "    \"uvicorn\",\n",
        "    \"python-multipart\",\n",
        "    \"psutil\",\n",
        "    \"huggingface_hub\",\n",
        "    \"safetensors\",\n",
        "    \"pyngrok\",\n",
        "    \"requests\"\n",
        "]\n\n",
        "subprocess.run(\n",
        "    [PYTHON, \"-m\", \"pip\", \"install\", \"-U\", *PACKAGES],\n",
        "    check=True\n",
        ")\n\n",
        "print(\"INSTALL COMPLETE\")\n"
      ]
