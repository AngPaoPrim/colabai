        "# ============================================================\n",
        "# CELL 7 — CREATE FINAL MULTI-VIEW API\n",
        "# PORT 8001\n",
        "# ============================================================\n",
        "\n",
        "from pathlib import Path\n",
        "import subprocess\n",
        "import time\n\nPYTHON = \"/content/hunyuan_mv_env/bin/python\"\nREPO = \"/content/Hunyuan3D-2\"\n\nBASE = Path(\n    \"/content/hunyuan3d_mv_server\"\n)\n\nBASE.mkdir(\n    parents=True,\n    exist_ok=True\n)\n\nSCRIPT = BASE / \"server.py\"\nLOG = BASE / \"server.log\"\n\n# Stop old server\nsubprocess.run(\n    [\n        \"pkill\",\n        \"-f\",\n        \"/content/hunyuan3d_mv_server/server.py\"\n    ],\n    stdout=subprocess.DEVNULL,\n    stderr=subprocess.DEVNULL,\n    check=False\n)\n\ntime.sleep(2)\n\nSERVER_CODE = r'''\\\nimport os\nimport sys\nimport gc\nimport uuid\nimport traceback\nfrom pathlib import Path\nfrom typing import Optional\n\nimport torch\nfrom PIL import Image\n\nfrom fastapi import (\n    FastAPI,\n    UploadFile,\n    File,\n    HTTPException,\n)\n\nfrom fastapi.responses import FileResponse\nimport uvicorn\n\n\n# ============================================================\n# ENVIRONMENT\n# ============================================================\n\nos.environ[\"PYTORCH_CUDA_ALLOC_CONF\"] = \"expandable_segments:True\"\nos.environ[\"CUDA_MODULE_LOADING\"] = \"LAZY\"\nos.environ[\"TOKENIZERS_PARALLELISM\"] = \"false\"\n\n\n# ============================================================\n# IMPORT OFFICIAL HY3DGEN API\n# ============================================================\n\nfrom hy3dgen.shapegen import (\n    Hunyuan3DDiTFlowMatchingPipeline\n)\n\n\n# ============================================================\n# PATHS\n# ============================================================\n\nBASE = Path(\n    \"/content/hunyuan3d_mv_server\"\n)\n\nUPLOADS = BASE / \"uploads\"\nOUTPUTS = BASE / \"outputs\"\n\nUPLOADS.mkdir(\n    parents=True,\n    exist_ok=True\n)\n\nOUTPUTS.mkdir(\n    parents=True,\n    exist_ok=True\n)\n\n\n# ============================================================\n# GPU INFO\n# ============================================================\n\nprint(\"=\" * 70, flush=True)\nprint(\"HUNYUAN3D-2MV TURBO\", flush=True)\nprint(\"=\" * 70, flush=True)\n\nprint(\n    \"Python:\",\n    sys.version,\n    flush=True\n)\n\nprint(\n    \"Torch:\",\n    torch.__version__,\n    flush=True\n)\n\nprint(\n    \"CUDA:\",\n    torch.cuda.is_available(),\n    flush=True\n)\n\nif not torch.cuda.is_available():\n    raise RuntimeError(\n        \"CUDA is not available.\"\n    )\n\nprint(\n    \"GPU:\",\n    torch.cuda.get_device_name(0),\n    flush=True\n)\n\nprops = torch.cuda.get_device_properties(0)\n\nprint(\n    \"VRAM:\",\n    round(\n        props.total_memory / 1024**3,\n        2\n    ),\n    \"GB\",\n    flush=True\n)\n\n\n# ============================================================\n# LOAD MODEL ONCE\n# ============================================================\n\nprint(\n    \"Loading tencent/Hunyuan3D-2mv...\",\n    flush=True\n)\n\npipeline = (\n    Hunyuan3DDiTFlowMatchingPipeline\n    .from_pretrained(\n        \"tencent/Hunyuan3D-2mv\",\n        subfolder=\"hunyuan3d-dit-v2-mv-turbo\",\n        variant=\"fp16\",\n        use_safetensors=True,\n        device=\"cuda\",\n    )\n)\n\nprint(\n    \"MODEL LOAD OK\",\n    flush=True\n)\n\nprint(\n    \"VRAM allocated:\",\n    round(\n        torch.cuda.memory_allocated() / 1024**3,\n        2\n    ),\n    \"GB\",\n    flush=True\n)\n\n\n# ============================================================\n# FLASHVDM\n# ============================================================\n\ntry:\n    pipeline.enable_flashvdm()\n    print(\n        \"FlashVDM: ENABLED\",\n        flush=True\n    )\nexcept Exception as error:\n    print(\n        \"FlashVDM: NOT ENABLED\",\n        repr(error),\n        flush=True\n    )\n\n\n# ============================================================\n# FASTAPI\n# ============================================================\n\napp = FastAPI(\n    title=\"Hunyuan3D-2mv Multi-View API\"\n)\n\n\n@app.get(\"/\")\ndef root():\n    return {\n        \"status\": \"online\",\n        \"model\": \"tencent/Hunyuan3D-2mv\",\n        \"mode\": \"multi-view\",\n        \"endpoint\": \"/generate_multi\",\n        \"views\": [\n            \"front\",\n            \"left\",\n            \"back\",\n            \"right\",\n        ],\n    }\n\n\n@app.get(\"/health\")\ndef health():\n    return {\n        \"status\": \"ok\",\n        \"model\": \"tencent/Hunyuan3D-2mv\",\n        \"mode\": \"multi-view\",\n        \"cuda\": torch.cuda.is_available(),\n        \"gpu\": torch.cuda.get_device_name(0),\n        \"vram_allocated_gb\": round(\n            torch.cuda.memory_allocated() / 1024**3,\n            2\n        ),\n    }\n\n\n@app.post(\"/generate_multi\")\nasync def generate_multi(\n    front: Optional[UploadFile] = File(None),\n    left: Optional[UploadFile] = File(None),\n    back: Optional[UploadFile] = File(None),\n    right: Optional[UploadFile] = File(None),\n):\n\n    incoming = {\n        \"front\": front,\n        \"left\": left,\n        \"back\": back,\n        \"right\": right,\n    }\n\n    views = {}\n    temp_files = []\n\n    try:\n\n        # ----------------------------------------------------\n        # Read supplied views\n        # ----------------------------------------------------\n\n        for role, upload in incoming.items():\n\n            if upload is None:\n                continue\n\n            filename = Path(\n                upload.filename or f\"{role}.png\"\n            ).name\n\n            path = (\n                UPLOADS\n                / f\"{uuid.uuid4().hex[:8]}_{filename}\"\n            )\n\n            path.write_bytes(\n                await upload.read()\n            )\n\n            temp_files.append(path)\n\n            try:\n                views[role] = (\n                    Image.open(path)\n                    .convert(\"RGBA\")\n                )\n            except Exception as error:\n                raise HTTPException(\n                    status_code=400,\n                    detail=(\n                        f\"Invalid image for {role}: \"\n                        f\"{error}\"\n                    ),\n                )\n\n\n        # ----------------------------------------------------\n        # Require at least 2 views\n        # ----------------------------------------------------\n\n        if len(views) < 2:\n            raise HTTPException(\n                status_code=400,\n                detail=(\n                    \"Provide at least 2 images. \"\n                    \"Recommended: front + left + back.\"\n                ),\n            )\n\n\n        print(\"=\" * 70, flush=True)\n        print(\n            \"MULTI-VIEW GENERATION\",\n            flush=True\n        )\n        print(\n            \"Views:\",\n            list(views.keys()),\n            flush=True\n        )\n        print(\n            \"VRAM before:\",\n            round(\n                torch.cuda.memory_allocated() / 1024**3,\n                2\n            ),\n            \"GB\",\n            flush=True\n        )\n\n\n        # ----------------------------------------------------\n        # Generate\n        # ----------------------------------------------------\n\n        with torch.inference_mode():\n\n            mesh = pipeline(\n\n                image=views,\n\n                # Official Turbo example uses 5 steps.\n                num_inference_steps=5,\n\n                octree_resolution=380,\n\n                num_chunks=20000,\n\n                generator=torch.manual_seed(12345),\n\n                output_type=\"trimesh\",\n            )[0]\n\n\n        print(\n            \"MESH GENERATED\",\n            flush=True\n        )\n\n\n        # ----------------------------------------------------\n        # Save GLB\n        # ----------------------------------------------------\n\n        output_name = (\n            \"multiview_\"\n            + uuid.uuid4().hex[:10]\n            + \".glb\"\n        )\n\n        output_path = (\n            OUTPUTS\n            / output_name\n        )\n\n        mesh.export(\n            str(output_path)\n        )\n\n        print(\n            \"GLB CREATED:\",\n            output_path,\n            flush=True\n        )\n\n\n        # ----------------------------------------------------\n        # Cleanup\n        # ----------------------------------------------------\n\n        del mesh\n\n        for image in views.values():\n            try:\n                image.close()\n            except Exception:\n                pass\n\n        del views\n\n        gc.collect()\n        torch.cuda.empty_cache()\n\n\n        return {\n            \"status\": \"completed\",\n            \"filename\": output_name,\n            \"result\": (\n                \"/result/\"\n                + output_name\n            ),\n        }\n\n\n    except HTTPException:\n        raise\n\n    except Exception as error:\n\n        traceback.print_exc()\n\n        raise HTTPException(\n            status_code=500,\n            detail=str(error)\n        )\n\n\n    finally:\n\n        for path in temp_files:\n            try:\n                path.unlink()\n            except Exception:\n                pass\n\n\n@app.get(\"/result/{filename}\")\ndef result(filename: str):\n\n    safe = Path(filename).name\n\n    path = (\n        OUTPUTS\n        / safe\n    )\n\n    if not path.exists():\n        raise HTTPException(\n            status_code=404,\n            detail=\"Result not found\"\n        )\n\n    return FileResponse(\n        str(path),\n        media_type=\"model/gltf-binary\",\n        filename=safe\n    )\n\n\n# ============================================================\n# RUN\n# ============================================================\n\nprint(\"=\" * 70, flush=True)\nprint(\n    \"MULTI-VIEW API STARTING ON 8001\",\n    flush=True\n)\nprint(\"=\" * 70, flush=True)\n\nuvicorn.run(\n    app,\n    host=\"127.0.0.1\",\n    port=8001,\n    log_level=\"info\",\n)\n'''\n\nSCRIPT.write_text(\n    SERVER_CODE\n)\n\n# Syntax check first\ncheck = subprocess.run(\n    [\n        PYTHON,\n        \"-m\",\n        \"py_compile\",\n        str(SCRIPT)\n    ],\n    capture_output=True,\n    text=True,\n)\n\nif check.returncode != 0:\n    print(check.stderr)\n    raise RuntimeError(\n        \"Multi-view server syntax error.\"\n    )\n\nprint(\"SYNTAX: OK\")\n\n# Start server\nlog_handle = open(\n    LOG,\n    \"w\",\n    buffering=1\n)\n\nprocess = subprocess.Popen(\n    [\n        PYTHON,\n        \"-u\",\n        str(SCRIPT)\n    ],\n    cwd=REPO,\n    stdout=log_handle,\n    stderr=subprocess.STDOUT,\n)\n\nprint(\n    \"Started PID:\",\n    process.pid\n)\n\nprint(\n    \"Log:\",\n    LOG\n)\n"
      ]
    },
