      "outputs": [],
      "source": [
        "# ============================================================\n",
        "# CELL 8 — NGROK MULTI-VIEW\n",
        "# ============================================================\n",
        "\n",
        "import requests\n",
        "from pyngrok import ngrok\n\n",
        "PORT = 8001\n\n",
        "# ใส่ token ของคุณ\n",
        "NGROK_TOKEN = \"ใส่_NGROK_TOKEN_ของคุณ\"\n\n",
        "if (\n",
        "    not NGROK_TOKEN\n",
        "    or NGROK_TOKEN.startswith(\"ใส่_\")\n",
        "):\n",
        "    raise RuntimeError(\n",
        "        \"ใส่ NGROK_TOKEN ใน Cell 8 ก่อน\"\n",
        "    )\n\n",
        "# ตรวจ local ก่อน\n",
        "local = requests.get(\n",
        "    f\"http://127.0.0.1:{PORT}/health\",\n        "    timeout=20\n",
        ")\n\n",
        "local.raise_for_status()\n\n",
        "print(\"LOCAL:\", local.json())\n\n",
        "ngrok.set_auth_token(\n",
        "    NGROK_TOKEN\n",
        ")\n\n",
        "# เปิด tunnel โดยไม่ kill tunnel อื่น\n",
        "tunnel = ngrok.connect(\n",
        "    addr=PORT,\n",
        "    proto=\"http\"\n",
        ")\n\n",
        "PUBLIC_URL = str(\n",
        "    tunnel.public_url\n",
        ")\n\n",
        "if PUBLIC_URL.startswith(\"http://\"):\n",
        "    PUBLIC_URL = (\n",
        "        \"https://\"\n",
        "        + PUBLIC_URL[7:]\n",
        "    )\n\n",
        "print()\n",
        "print(\"=\" * 70)\n",
        "print(\"✅ MULTI-VIEW NGROK READY\")\n",
        "print(\"=\" * 70)\n",
        "print(\"PUBLIC URL:\", PUBLIC_URL)\n",
        "print(\"HEALTH:\", PUBLIC_URL + \"/health\")\n",
        "print(\"GENERATE:\", PUBLIC_URL + \"/generate_multi\")\n\n",
        "public = requests.get(\n",
        "    PUBLIC_URL + \"/health\",\n        "    timeout=30\n",
        ")\n\n",
        "public.raise_for_status()\n\n",
        "print(\"PUBLIC HEALTH:\", public.json())\n"
      ]
    },
    {
      "cell_type": "code",
