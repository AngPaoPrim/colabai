      "execution_count": null,
      "outputs": [],
      "source": [
        "# ============================================================\n",
        "# CELL 9 — OPTIONAL DIRECT MULTI-VIEW TEST\n",
        "# ============================================================\n",
        "\n",
        "from google.colab import files\n",
        "from pathlib import Path\n",
        "import requests\n\n",
        "print(\"=\" * 70)\n",
        "print(\"UPLOAD MULTI-VIEW IMAGES\")\n",
        "print(\"=\" * 70)\n\n",
        "print(\n",
        "    \"ตั้งชื่อไฟล์ เช่น front.png left.png back.png right.png\"\n",
        ")\n\n",
        "uploaded = files.upload()\n\n",
        "views = {}\n\n",
        "for name in uploaded:\n\n",
        "    lower = name.lower()\n",
        "    path = Path(\"/content\") / name\n\n",
        "    if \"front\" in lower:\n",
        "        views[\"front\"] = path\n",
        "    elif \"left\" in lower:\n",
        "        views[\"left\"] = path\n",
        "    elif \"back\" in lower:\n",
        "        views[\"back\"] = path\n",
        "    elif \"right\" in lower:\n",
        "        views[\"right\"] = path\n\n",
        "if len(views) < 2:\n",
        "    raise RuntimeError(\n",
        "        \"ต้องมีอย่างน้อย 2 รูป\"\n",
        "    )\n\n",
        "print(\n",
        "    \"Views:\",\n",
        "    list(views.keys())\n",
        ")\n\n",
        "handles = []\n",
        "payload = []\n\n",
        "try:\n\n",
        "    for role, path in views.items():\n\n",
        "        handle = open(path, \"rb\")\n",
        "        handles.append(handle)\n\n",
        "        payload.append(\n",
        "            (\n",
        "                role,\n",
        "                (\n",
        "                    path.name,\n",
        "                    handle,\n",
        "                    \"application/octet-stream\"\n",
        "                )\n",
        "            )\n",
        "        )\n\n",
        "    response = requests.post(\n",
        "        PUBLIC_URL + \"/generate_multi\",\n",
        "        files=payload,\n",
        "        timeout=3600\n",
        "    )\n\n",
        "finally:\n\n",
        "    for handle in handles:\n\n",
        "        try:\n",
        "            handle.close()\n",
        "        except Exception:\n",
        "            pass\n\n",
        "response.raise_for_status()\n\n",
        "data = response.json()\n\n",
        "print()\n",
        "print(\"SERVER RESPONSE:\")\n",
        "print(data)\n\n",
        "output = (\n",
        "    Path(\"/content\")\n",
        "    / data[\"filename\"]\n",
        ")\n\n",
        "result_url = (\n",
        "    PUBLIC_URL\n",
        "    + data[\"result\"]\n",
        ")\n\n",
        "with requests.get(\n",
        "    result_url,\n",
        "    stream=True,\n",
        "    timeout=600\n",
        ") as response:\n\n",
        "    response.raise_for_status()\n\n",
        "    with open(output, \"wb\") as f:\n\n",
        "        for chunk in response.iter_content(\n",
        "            chunk_size=1024 * 1024\n",
        "        ):\n\n",
        "            if chunk:\n",
        "                f.write(chunk)\n\n",
        "print()\n",
        "print(\"=\" * 70)\n",
        "print(\"✅ MULTI-VIEW GLB CREATED\")\n",
        "print(\"=\" * 70)\n",
        "print(\"Output:\", output)\n",
        "print(\n",
        "    \"Size:\",\n",
        "    round(\n",
        "        output.stat().st_size / 1024**2,\n",
        "        2\n",
        "    ),\n",
        "    \"MB\"\n",
        ")\n"
      ]
    }
